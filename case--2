
bills = []
months = int(input("Enter number of months: "))

for i in range(months):
    units = float(input("Enter units consumed: "))

    if units <= 100:
        energy = units * 2
    elif units <= 200:
        energy = 100 * 2 + (units - 100) * 3
    elif units <= 300:
        energy = 100 * 2 + 100 * 3 + (units - 200) * 5
    else:
        energy = 100 * 2 + 100 * 3 + 100 * 5 + (units - 300) * 7

    fixed = 50
    surcharge = energy * 0.10 if units > 300 else 0
    rebate = energy * 0.05 if units < 100 else 0

    total = energy + fixed + surcharge - rebate
    bills.append(total)

    print("Energy charge:", round(energy, 2))
    print("Total bill:", round(total, 2))

for i in range(1, months):
    increase = bills[i] - bills[i - 1]
    if increase > 0.5 * bills[i - 1]:
        print("Unusual increase in month", i + 1)
