
n = int(input("Number of products: "))
subtotal = 0
tax_total = 0

for i in range(n):
    print("\nProduct", i + 1)
    name = input("Product name: ")
    price = float(input("Unit price: "))
    quantity = int(input("Quantity: "))
    category = input("Category (food/electronics/other): ").lower()

    if price < 0 or quantity <= 0:
        print("Invalid product details")
        continue

    amount = price * quantity

    if category == "food":
        tax_rate = 0.05
    elif category == "electronics":
        tax_rate = 0.18
    else:
        tax_rate = 0.12

    subtotal += amount
    tax_total += amount * tax_rate

    print("Item:", name)
    print("Amount:", round(amount, 2))
    print("Tax:", round(amount * tax_rate, 2))

if subtotal >= 5000:
    discount = subtotal * 0.10
elif subtotal >= 2000:
    discount = subtotal * 0.05
else:
    discount = 0

discount = min(discount, 1000)
total = subtotal - discount + tax_total

print("\n----- RETAIL INVOICE -----")
print("Subtotal:", round(subtotal, 2))
print("Discount:", round(discount, 2))
print("Total tax:", round(tax_total, 2))
print("Final amount:", round(total, 2))
